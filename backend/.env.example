# =======================================================================
# Halo backend — variáveis lidas em dev via spring-dotenv (pom.xml).
# Copie este arquivo para backend/.env e ajuste antes de rodar
# `mvn spring-boot:run`. Em produção, prefira variáveis de ambiente
# reais (não comite o .env).
# =======================================================================

# ------- Datasource -------
# Valores são iguais aos do infra/.env (o compose dev usa os mesmos
# defaults). Se mudou POSTGRES_HOST_PORT ali, ajuste a porta da URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/halo
SPRING_DATASOURCE_USERNAME=halo
SPRING_DATASOURCE_PASSWORD=halo

# ------- Evolution Go (webhook + envio) -------
# DEVE ser o MESMO valor de EVOLUTION_API_KEY do infra/.env. É a global
# api-key do Evolution — usada nas chamadas de SAÍDA do backend para os
# endpoints globais do Evolution (/instance/all etc.).
#
# Nota: o webhook que CHEGA no backend (POST /webhooks/evolution) NÃO usa
# essa chave. O Evolution Go self-hosted não envia headers de auth em
# webhooks de saída (issue upstream #1933 closed as not-planned), então
# o endpoint fica aberto — a proteção é de rede / reverse proxy à frente.
EVOLUTION_API_KEY=

# Nome da instância criada via Manager UI ou POST /instance/create do
# Evolution (T-006). Default `halo-bot`.
EVOLUTION_INSTANCE=halo-bot

# Token RETORNADO no campo `data.token` por `POST /instance/create`.
# É o segundo nível de auth descrito em CLAUDE.md §"Evolution Go — modelo
# de auth em 2 níveis" — necessário para os endpoints POR INSTÂNCIA, como
# `POST /message/sendText/{instance}` usado pelo HttpEvolutionClient (T-011+).
#
# Como recuperar caso tenha perdido (sem precisar recriar a instância):
#   curl -H "apikey: $EVOLUTION_API_KEY" \
#     http://localhost:8081/instance/fetchInstances?instanceName=halo-bot
# → o campo `hash` (ou `token`) na resposta é o valor que vai aqui.
EVOLUTION_INSTANCE_TOKEN=

# ------- Web pública (comando WhatsApp "site/link/web", T-037) -------
# URL do PWA enviada quando o usuário pede o link no WhatsApp (RF-10).
HALO_WEB_PUBLIC_URL=http://localhost:5173

# ------- Segurança / CORS (T-021) -------
# Origens autorizadas a chamar a API com credenciais (cookie do refresh).
# Lista separada por vírgula. Default em application.yml cobre o Vite dev
# server local (http://localhost:5173). Em produção, apontar para o
# domínio do PWA, ex.: HALO_SECURITY_CORS_ALLOWED_ORIGINS=https://halo.app
HALO_SECURITY_CORS_ALLOWED_ORIGINS=

# ------- Auth / JWT (T-020) -------
# Segredo HMAC-SHA256 usado para assinar os access tokens emitidos por
# POST /auth/otp/verify. Deve ser base64 de pelo menos 32 bytes (256 bits).
#
# Gere um valor novo em produção, ex.:
#   openssl rand -base64 48
#
# O default no application.yml só serve para dev/teste local.
HALO_AUTH_JWT_SECRET=

# ------- Gemini (parser de gastos, T-013) -------
# Chave da API gerada em https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Default funciona em prod e dev; sobrescreva apenas para apontar para
# um proxy/mock.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Modelo default analise-tecnica §9.1. Troque para gemini-2.5-pro se
# precisar de maior acurácia.
# GEMINI_MODEL=gemini-2.5-flash

# ------- Java runtime (não é lido pelo spring-dotenv, mas serve de
# documentação caso queira exportar antes do mvn) -------
# Spring Boot 3.3 exige Java 21.
# JAVA_HOME=/usr/lib/jvm/java-21-amazon-corretto
