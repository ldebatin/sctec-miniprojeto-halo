# =======================================================================
# Halo — variáveis do docker-compose dev (infra/docker-compose.yml)
# Copie este arquivo para infra/.env e ajuste os valores marcados com
# <change-me> antes de subir.
# =======================================================================

# ----------- Postgres -----------
POSTGRES_USER=halo
POSTGRES_PASSWORD=halo
POSTGRES_DB=halo
POSTGRES_HOST_PORT=5432

# ----------- Timezone -----------
TZ=America/Sao_Paulo

# ----------- Evolution Go -----------
# CLIENT_NAME identifica esta instância nos logs do Evolution.
EVOLUTION_CLIENT_NAME=halo

# GLOBAL_API_KEY do Evolution. Gere com:
#   openssl rand -hex 16
# É a mesma chave que o backend usará em EVOLUTION_API_KEY (analise-tecnica §13.3)
# e que o Evolution exige no header `apikey` das chamadas.
EVOLUTION_API_KEY=<change-me-openssl-rand-hex-16>

# Porta exposta no host. Default 8081 para não colidir com o backend
# Spring Boot que roda em :8080. Dentro da rede docker o serviço
# continua escutando em 8080 — quem precisa apontar para o Evolution
# de fora do compose usa http://localhost:8081.
EVOLUTION_HOST_PORT=8081

# URL pública do webhook do backend (deixe vazio em dev sem ngrok/túnel).
# Em produção, aponta para https://api.halo.<domain>/webhooks/evolution.
EVOLUTION_WEBHOOK_URL=

# ----------- Profile `app` (opcional) -----------
# Variáveis usadas APENAS quando você sobe o stack completo via
# `docker compose --profile app up -d`. Sem o profile, são ignoradas.

# Portas do host para os containers backend/frontend.
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173

# URL da API que o frontend bundlado vai chamar (build arg do Vite,
# resolvida no momento do `docker compose build`).
# Aponta para o backend acessível DE FORA do compose — o browser do
# usuário não enxerga a rede docker, então usa localhost.
VITE_API_BASE_URL=http://localhost:8080
