# =======================================================================
# Halo — variáveis do docker-compose dev (infra/docker-compose.yml)
# Copie este arquivo para infra/.env e ajuste os valores marcados com
# <change-me> antes de subir.
# =======================================================================

# ----------- Postgres -----------
POSTGRES_USER=halo
POSTGRES_PASSWORD=halo
POSTGRES_DB=halo
POSTGRES_HOST_PORT=5432

# ----------- Timezone -----------
TZ=America/Sao_Paulo

# ----------- Evolution Go -----------
# CLIENT_NAME identifica esta instância nos logs do Evolution.
EVOLUTION_CLIENT_NAME=halo

# GLOBAL_API_KEY do Evolution. Gere com:
#   openssl rand -hex 16
# É a mesma chave que o backend usará em EVOLUTION_API_KEY (analise-tecnica §13.3)
# e que o Evolution exige no header `apikey` das chamadas.
EVOLUTION_API_KEY=<change-me-openssl-rand-hex-16>

# Porta exposta no host. Em dev local, conflita com o backend Spring Boot
# (T-002 usa :8080). Se quiser rodar os dois ao mesmo tempo, troque aqui
# (ex.: 8088) e ajuste a EVOLUTION_BASE_URL do backend.
EVOLUTION_HOST_PORT=8080

# URL pública do webhook do backend (deixe vazio em dev sem ngrok/túnel).
# Em produção, aponta para https://api.halo.<domain>/webhooks/evolution.
EVOLUTION_WEBHOOK_URL=
